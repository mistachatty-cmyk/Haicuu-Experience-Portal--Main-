{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "BASE_PATH=/ PORT=3000 NODE_ENV=production pnpm --filter @workspace/haiku-experience run build",
  "outputDirectory": "artifacts/haiku-experience/dist/public",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
